{"version": 2, "width": 110, "height": 30, "timestamp": 1792709400, "idle_time_limit": 2.0, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}, "title": "Primitive DB: CRUD, ошибки, декораторы и кэш"}
[0.033172, "o", "\r\n***Операции с данными***\r\nФункции:\r\n<command> list_tables - показать список всех таблиц\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> .. - создать таблицу\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> help справочная информация\r\n<command> exit - выход из программы\r\n<command> insert into <таблица> values (...) - добавить запись\r\n<command> select from <таблица> [where ...] - показать записи\r\n<command> delete from <таблица> where <столбец> = <значение> - удалить записи\r\n<command> update <таблица> set <столбец> = <значение> where ... - обновить записи\r\n<command> info <таблица> - показывает информацию о таблице\r\n\r\n>>>Введите команду: "]
[2.033172, "o", "create_table users name:str age:int is_active:bool\r\n"]
[2.033359, "o", "\r\n"]
[2.033816, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[2.034315, "o", ">>>Введите команду: "]
[4.034315, "o", "insert into users values (\"Sergei\", 28, true)\r\n"]
[4.03446, "o", "\r\n"]
[4.034837, "o", "Запись с ID=0 успешно добавлена в таблицу \"users\".\r\nВремя выполнения insert: 0.000035 с\r\n"]
[4.035532, "o", ">>>Введите команду: "]
[5.835532, "o", "select from users where age = 28\r\n"]
[5.836347, "o", "\r\nВремя выполнения select: 0.000066 с\r\n"]
[6.537244, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 0  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n>>>Введите команду: "]
[8.337244, "o", "select from users where age = 28\r\n"]
[8.337513, "o", "\r\n"]
[8.337913, "o", "Время выполнения select: 0.000054 с\r\n"]
[8.338174, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 0  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[8.33824, "o", ">>>Введите команду: "]
[10.13824, "o", "insert into users values (\"Bad\", \"oops\", true)\r\n"]
[10.138378, "o", "\r\n"]
[10.138628, "o", "Некорректное значение: invalid literal for int() with base 10: 'oops'. Попробуйте снова.\r\n>>>Введите команду: "]
