[27.721487, "o", "bash-3.2$ "]
[46.226694, "o", "databa"]
[46.226718, "o", "se\r\n"]
[46.496224, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[46.496281, "o", ">>>Введите команду: "]
[60.248757, "o", "create_table users name:str age:int is_active:bool\r\n"]
[60.248804, "o", "\r\n"]
[60.24894, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[60.249644, "o", ">>>Введите команду: "]
[61.354609, "o", "create_table users name:str\r\n"]
[61.354685, "o", "\r\n"]
[61.354944, "o", "Ошибка: Таблица \"users\" уже существует.\r\n"]
[61.355425, "o", ">>>Введите команду: "]
[62.459726, "o", "list_tables\r\n"]
[62.459851, "o", "\r\n- users\r\n"]
[62.459994, "o", ">>>Введите команду: "]
[63.56465, "o", "exit\r\n"]
[63.565324, "o", "\r\n"]
[63.574578, "o", "bash-3.2$ "]
[64.669916, "o", "dat"]
[64.670219, "o", "abase\r\n"]
[64.717145, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[64.717234, "o", ">>>Введите команду: "]
[65.774602, "o", "list_tables\r\n"]
[65.774741, "o", "\r\n"]
[65.774757, "o", "- users\r\n"]
[65.775006, "o", ">>>Введите команду: "]
[66.879777, "o", "drop_table users\r\n"]
[66.880645, "o", "\r\nТаблица \"users\" успешно удалена.\r\n"]
[66.882302, "o", ">>>Введите команду: "]
[67.987704, "o", "drop_table products\r\n"]
[67.988682, "o", "\r\nОшибка: Таблица \"products\" не существует.\r\n"]
[67.988964, "o", ">>>Введите команду: "]
[69.093938, "o", "create_table products name:str ID:int\r\n"]
[69.094171, "o", "\r\n"]
[69.094922, "o", "Таблица \"products\" успешно создана со столбцами: ID:int, name:str\r\n"]
[69.095738, "o", ">>>Введите команду: "]
[70.198607, "o", "list_tables\r\n"]
[70.198726, "o", "\r\n"]
[70.198903, "o", "- products\r\n"]
[70.200026, "o", ">>>Введите команду: "]
[71.305318, "o", "drop_table products\r\n"]
[71.305382, "o", "\r\n"]
[71.30552, "o", "Таблица \"products\" успешно удалена.\r\n"]
[71.306928, "o", ">>>Введите команду: "]
[72.409912, "o", "create_table invalid age:float\r\n"]
[72.410177, "o", "\r\nНекорректное значение: age:float. Попробуйте снова.\r\n"]
[72.41123, "o", ">>>Введите команду: "]
[73.516961, "o", "create_table \"broken\r\n"]
[73.518335, "o", "\r\nНекорректное значение: create_table \"broken. Попробуйте снова.\r\n"]
[73.518622, "o", ">>>Введите команду: "]
[74.622952, "o", "help\r\n"]
[74.624129, "o", "\r\n\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[74.624527, "o", ">>>Введите команду: "]
[75.726361, "o", "exit\r\n"]
[75.726397, "o", "\r\n"]
[75.730886, "o", "bash-3.2$ "]
[76.832272, "o", "exit\r\n"]
[76.832512, "o", "exit\r\n"]
